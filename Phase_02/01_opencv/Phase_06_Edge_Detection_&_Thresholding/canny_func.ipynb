   "source": [
    "import cv2\n",
    "\n",
    "img = cv2.imread('horse.jpg', cv2.IMREAD_GRAYSCALE)\n",
    "edge =  cv2.Canny(img, 50, 150)\n",
    "\n",
    "cv2.imshow('Original', img)\n",
    "cv2.imshow('Canny Edge', edge)\n",
    "cv2.waitKey(0)\n",
    "cv2.destroyAllWindows()\n",
    "cv2.imwrite('horse_edge.jpg', edge)\n",
    "\n"
   ]
  }
 ],
